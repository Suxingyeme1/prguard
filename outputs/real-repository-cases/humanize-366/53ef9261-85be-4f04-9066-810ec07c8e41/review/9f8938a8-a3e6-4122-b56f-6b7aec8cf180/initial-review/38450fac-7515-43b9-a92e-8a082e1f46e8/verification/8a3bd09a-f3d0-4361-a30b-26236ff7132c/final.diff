+def _extract_numeric_format(format: str) -> str:
+    """Return the printf conversion specifier that consumes the value."""
+    i = 0
+    while i < len(format):
+        if format[i] != "%":
+            i += 1
+            continue
+        if i + 1 < len(format) and format[i + 1] == "%":
+            i += 2
+            continue
+        start = i
+        i += 1
+        while i < len(format) and format[i] in "#0- +":
+            i += 1
+        if i < len(format) and format[i] == "*":
+            i += 1
+        else:
+            while i < len(format) and format[i].isdigit():
+                i += 1
+        if i < len(format) and format[i] == ".":
+            i += 1
+            if i < len(format) and format[i] == "*":
+                i += 1
+            else:
+                while i < len(format) and format[i].isdigit():
+                    i += 1
+        if i < len(format) and format[i] in "hlL":
+            i += 1
+        if i < len(format) and format[i] in "diouxXeEfFgGcrsa":
+            return format[start : i + 1]
+        i += 1
+    return format
+
