+@pytest.mark.skipif(
+    sys.version_info[:2] < (3, 14),
+    reason="Python 3.14+ lazily evaluates annotations.",
+)
+def test_classvar_forward_ref_py_314():
+    """
+    ClassVars that are only imported under TYPE_CHECKING are recognized.
+    """
+    from typing import TYPE_CHECKING
+
+    if TYPE_CHECKING:
+        from typing import ClassVar  # noqa: F401
+
+    @attrs.define
+    class T:
+        t: ClassVar[str]  # noqa: F821
+
+    T()
+
+    assert "t" not in {a.name for a in attrs.fields(T)}
